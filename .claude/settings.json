{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help*)",
      "Bash(make lint*)",
      "Bash(make typecheck*)",
      "Bash(make test*)",
      "Bash(make format-check*)",
      "Bash(make contracts-check*)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npx jest *)",
      "Bash(npx vitest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(glab *)",
      "Bash(make ci*)",
      "Bash(make db-*)",
      "Bash(make eval*)",
      "Bash(npx prisma *)",
      "Bash(docker *)",
      "Bash(kubectl *)"
    ],
    "deny": ["Read(./.env*)", "Read(./**/*.pem)", "Bash(git push --force*)"]
  }
}
