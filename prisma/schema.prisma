// Schema for the tables 012 owns. Domain tables belong to their own specs and are added
// by those features; this file is multi-schema so each feature's tables stay in their own
// Postgres schema rather than in one namespace (ADR 0004, prisma rules).

generator client {
  provider        = "prisma-client-js"
  output          = "../prisma/generated/client"
  // postgresqlExtensions declares the approved extension list of ADR 0004 in the
  // schema itself, so `db-check` can assert it rather than trusting a runbook.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
  schemas    = ["workflow", "prompt", "tenant", "runner", "agent", "issue", "evidence", "audit", "events", "policy"]
}

// ─────────────────────────────── workflow execution ───────────────────────────────

/// The persisted state machine. Its transitions are the machine-step half of 001's
/// timeline; nothing here is copied into 001's issue_event (C-14).
model WorkflowRun {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  issueId           String    @map("issue_id") @db.Uuid
  definitionKey     String    @map("definition_key")
  /// Pinned at start: a redeploy does not migrate a running instance.
  definitionVersion Int       @map("definition_version")
  state             String
  /// What this run is waiting for — callback kind, token reference, deadline.
  awaiting          Json?
  correlationId     String    @map("correlation_id") @db.Uuid
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// The state's own timeout, fired by a scheduled tick — never by a waiting worker.
  deadlineAt        DateTime? @map("deadline_at") @db.Timestamptz(6)
  /// Set once. A terminal run never transitions again.
  terminalState     String?   @map("terminal_state")

  transitions WorkflowTransition[]
  callbacks   WorkflowCallback[]

  // Backs WorkflowTransition's composite FK (runId, tenantId) — id alone is already
  // unique via @id, but Postgres requires a unique constraint on exactly the referenced
  // column set. This is what makes a transition naming the wrong tenant unrepresentable,
  // rather than merely unindexed (FR-048).
  @@unique([id, tenantId])
  @@index([tenantId, state])
  // 001 T046: GetTimeline joins an issue's machine steps through this column.
  @@index([tenantId, issueId])
  // The deadline index is partial — `where terminal_state is null` — because the sweep
  // only ever looks at live runs. Prisma cannot express a partial index, so it is created
  // in the migration and deliberately not declared here; declaring a plain index as well
  // would have Prisma manage a second, larger one covering rows no query reads.
  @@map("workflow_run")
  @@schema("workflow")
}

/// Append-only. Insert-only database rules land with 001 T003, which owns the
/// append-only enforcement pattern for every immutable table.
model WorkflowTransition {
  id            String          @id @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  runId         String          @map("run_id") @db.Uuid
  fromState     String          @map("from_state")
  toState       String          @map("to_state")
  cause         TransitionCause
  actorRef      String?         @map("actor_ref")
  payloadDigest String?         @map("payload_digest")
  occurredAt    DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)

  // Composite FK against WorkflowRun's (id, tenantId): a transition naming any tenant
  // other than its run's is rejected by Postgres, not merely mis-indexed (FR-048).
  run WorkflowRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, runId, occurredAt])
  @@map("workflow_transition")
  @@schema("workflow")
}

enum TransitionCause {
  job
  callback
  timeout
  human
  policy

  @@map("transition_cause")
  @@schema("workflow")
}

/// What makes "never wait inside a job" possible (ADR 0003).
model WorkflowCallback {
  id            String       @id @db.Uuid
  runId         String       @map("run_id") @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  kind          CallbackKind
  /// The token is stored hashed: a callback URL in a CI log is not a credential leak.
  tokenHash     String       @unique @map("token_hash")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime?    @map("consumed_at") @db.Timestamptz(6)
  /// A second delivery increments this and changes nothing else.
  receivedCount Int          @default(0) @map("received_count")

  // Composite FK against WorkflowRun's (id, tenantId) — the same fix applied to
  // WorkflowTransition when this gap was first found (FR-048); this table had the identical gap
  // and was missed at the time, caught later by review.
  run WorkflowRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, kind])
  @@index([runId])
  @@map("workflow_callback")
  @@schema("workflow")
}

enum CallbackKind {
  ci_result
  deploy_result
  verification_tick
  approval
  runner_result

  @@map("callback_kind")
  @@schema("workflow")
}

// ────────────────────────────────────── outbox ─────────────────────────────────────

/// The transactional outbox (012 FR-031, consumed by 001 FR-014, `packages/events`). Written in
/// the same transaction as the state change it describes; published to the broker afterwards,
/// from this table — never "publish after commit" from application code, which fails silently
/// exactly when the process dies between the two. 012 T012 built only the pure logic
/// (`packages/events/src/outbox.ts`); this table is its first real backing store (001 T013).
model Outbox {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  /// The aggregate this is about — an issue, a run, a tenant (`DomainEvent.subjectId`).
  subjectId     String    @map("subject_id")
  correlationId String    @map("correlation_id")
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  /// Set by `claimUnpublished` (`SELECT ... FOR UPDATE SKIP LOCKED`, 001 review finding): makes
  /// two concurrent drain workers' claims mutually exclusive without either blocking on the
  /// other. A claim older than the reclaim timeout is treated as an abandoned (crashed) worker.
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)

  // Kept even though the claim query itself never filters by tenant (see `PrismaOutboxStore`'s
  // doc comment) — `outbox` is still tenant-scoped by every other convention
  // (prisma-migrations.md), and the migration e2e suite's leading-tenant_id-index check enforces
  // that every tenant-scoped table keeps one regardless of what the busiest query needs.
  @@index([tenantId, publishedAt, occurredAt])
  // The deliberately un-Prisma-declared partial index (`outbox_claim_idx`, migration
  // `20260927040000`) matches the claim query's real shape instead — `where published_at is
  // null`, ordered `attempts, occurred_at` — which a plain composite index Prisma can express
  // here cannot.
  @@map("outbox")
  @@schema("events")
}

// ───────────────────────────────────── prompts ─────────────────────────────────────

/// Immutable and content-addressed (R-07). No update path exists: runtime resolves by
/// id, never by key, so an audit entry from a year ago cannot point at new text.
model PromptVersion {
  id          String   @id @db.Uuid
  key         String
  digest      String
  body        String
  schemaRef   String?  @map("schema_ref")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy String   @map("published_by")

  agentRuns AgentRun[]

  @@unique([key, digest])
  @@index([key, publishedAt])
  @@map("prompt_version")
  @@schema("prompt")
}

// ──────────────────────────────── tenant configuration ────────────────────────────

model Tenant {
  id        String       @id @db.Uuid
  name      String
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  providerConfig TenantProviderConfig?
  budgets        TenantBudget[]
  runners        RunnerRegistration[]

  @@map("tenant")
  @@schema("tenant")
}

enum TenantStatus {
  active
  suspended
  deleting

  @@map("tenant_status")
  @@schema("tenant")
}

/// Per-tenant LLM access (ADR 0006, R-08).
model TenantProviderConfig {
  tenantId      String        @id @map("tenant_id") @db.Uuid
  mode          ProviderMode
  provider      ProviderName
  endpoint      String?
  /// A reference into the secret manager. Never the secret.
  credentialRef String        @map("credential_ref")
  /// One value on purpose: cross-provider fallback for a BYO tenant is not
  /// representable, not merely defaulted off (R-08).
  fallbackScope FallbackScope @default(within_tenant_providers) @map("fallback_scope")
  modelTierMap  Json          @map("model_tier_map")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_provider_config")
  @@schema("tenant")
}

enum ProviderMode {
  healer_provided
  customer_byo

  @@map("provider_mode")
  @@schema("tenant")
}

enum ProviderName {
  anthropic
  openai
  bedrock
  vertex

  @@map("provider_name")
  @@schema("tenant")
}

enum FallbackScope {
  within_tenant_providers

  @@map("fallback_scope")
  @@schema("tenant")
}

/// Consumed by 002, which inherits these limits rather than converting them.
model TenantBudget {
  tenantId          String       @map("tenant_id") @db.Uuid
  period            BudgetPeriod
  spendLimit        Decimal      @map("spend_limit") @db.Decimal(12, 4)
  timeLimit         Int          @map("time_limit")
  /// An array, matching 002's budget_limit: degradation has ordered steps.
  softThresholdPcts Int[]        @map("soft_threshold_pcts")
  degradationOrder  String[]     @map("degradation_order")
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, period])
  @@map("tenant_budget")
  @@schema("tenant")
}

enum BudgetPeriod {
  day
  month

  @@map("budget_period")
  @@schema("tenant")
}

// ───────────────────────────────────── runner ─────────────────────────────────────

model RunnerRegistration {
  id              String       @id @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  name            String
  protocolVersion Int          @map("protocol_version")
  /// Declared, never inferred (R-03).
  capabilities    String[]
  imageVersion    String       @map("image_version")
  status          RunnerStatus
  lastHeartbeatAt DateTime     @map("last_heartbeat_at") @db.Timestamptz(6)
  refusedReason   String?      @map("refused_reason")

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resolutions RunnerCapabilityResolution[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("runner_registration")
  @@schema("runner")
}

enum RunnerStatus {
  active
  degraded
  refused
  revoked

  @@map("runner_status")
  @@schema("runner")
}

/// Append-only. Why a given run behaved as it did, months later.
model RunnerCapabilityResolution {
  id                  String            @id @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  runId               String            @map("run_id") @db.Uuid
  runnerId            String            @map("runner_id") @db.Uuid
  requestedCapability String            @map("requested_capability")
  outcome             CapabilityOutcome
  reason              String
  occurredAt          DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)

  runner RunnerRegistration @relation(fields: [runnerId], references: [id], onDelete: Restrict)

  @@index([tenantId, runId])
  @@map("runner_capability_resolution")
  @@schema("runner")
}

enum CapabilityOutcome {
  available
  degraded
  refused

  @@map("capability_outcome")
  @@schema("runner")
}

// ────────────────────────────────── self-observation ──────────────────────────────

/// The single store of the agent-run facts (FR-033). 001's audit_entry stands alongside
/// it and reaches these fields through agentRunId — it is not a second store (C-13).
model AgentRun {
  id               String       @id @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  issueId          String?      @map("issue_id") @db.Uuid
  correlationId    String       @map("correlation_id") @db.Uuid
  agentKind        AgentKind    @map("agent_kind")
  promptVersionId  String       @map("prompt_version_id") @db.Uuid
  modelId          String       @map("model_id")
  provider         ProviderName
  inputTokens      Int          @map("input_tokens")
  outputTokens     Int          @map("output_tokens")
  cost             Decimal      @db.Decimal(12, 6)
  /// Name, argument digest and outcome — never raw arguments, which carry paths and
  /// excerpts, and this table is read by support.
  toolCalls        Json         @map("tool_calls")
  policyDecisionId String?      @map("policy_decision_id") @db.Uuid
  outcome          String
  startedAt        DateTime     @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?    @map("finished_at") @db.Timestamptz(6)

  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)

  @@index([tenantId, startedAt])
  @@index([correlationId])
  @@map("agent_run")
  @@schema("agent")
}

enum AgentKind {
  investigator
  change
  verifier
  support
  test_author

  @@map("agent_kind")
  @@schema("agent")
}

// ─────────────────────────── issue lifecycle and evidence substrate (001) ───────────────────────

/// One aggregate for every source. `related`/`recurrence_of`/`merged_into` links live in
/// IssueRelationship, not as columns here (FR-020) — a relationship is a row, not a column, so
/// `related` can be many while the single-valued kinds stay at most one.
model Issue {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  kind            IssueKind
  componentId     String?       @map("component_id") @db.Uuid
  environment     String
  severity        IssueSeverity
  state           IssueState
  fingerprint     String
  /// Which normalisation ruleset version produced the fingerprint (R-01) — a historical
  /// fingerprint is recomputed with the version the issue recorded, never the current one.
  rulesetVersion  Int           @map("ruleset_version")
  occurrenceCount BigInt        @default(1) @map("occurrence_count")
  firstSeenAt     DateTime      @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @map("last_seen_at") @db.Timestamptz(6)
  /// Set by the staleness job (R-11) — surfaced, never auto-resolving.
  staleAt         DateTime?     @map("stale_at") @db.Timestamptz(6)
  /// Set when `state` moves to `resolved`, cleared on reopen (001 T022, FR-005) — what the reopen
  /// window is measured against. Not derivable cheaply from `issue_event` alone on the ingestion
  /// hot path: recomputing "when was this last resolved" from the event log on every signal that
  /// misses `findOpenByFingerprint` would cost a second query per ingestion; this is the same
  /// denormalized-status-timestamp shape `staleAt` already uses.
  resolvedAt      DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // A fingerprint's ruleset_version can only ever name a version that was really published
  // (001 T011, R-01) — a foreign key, not a plain int a caller could invent.
  ruleset NormalisationRuleset @relation(fields: [rulesetVersion], references: [version], onDelete: Restrict)

  events          IssueEvent[]
  relationships   IssueRelationship[] @relation("IssueRelationshipSubject")
  relatedFrom     IssueRelationship[] @relation("IssueRelationshipOther")
  evidenceRecords Evidence[]

  // Backs the composite FKs from IssueRelationship, IssueEvent and Evidence — id alone is
  // already unique via @id, but Postgres requires a unique constraint on exactly the referenced
  // column set, which is what makes a row naming the wrong tenant's issue unrepresentable
  // rather than merely unindexed (FR-048, same pattern as 012's WorkflowRun).
  @@unique([id, tenantId])
  // The fingerprint lookup index is partial — `where state not in ('merged', 'removed')` — since
  // a `resolved` issue must stay findable for FR-005's reopen window and a `stale` one is
  // "surfaced, not closed" (R-11). Prisma cannot express a partial index, so it lives in the
  // migration only, the same pattern as WorkflowRun's deadline index (012 data-model.md).
  @@index([tenantId, state, lastSeenAt])
  @@index([tenantId, componentId, lastSeenAt])
  @@map("issue")
  @@schema("issue")
}

enum IssueKind {
  production_incident
  user_report
  monitoring_alert
  regression
  automated_detection
  /// Terminates at human adjudication; never enters reproduction or change (FR-001a).
  knowledge_drift

  @@map("issue_kind")
  @@schema("issue")
}

enum IssueSeverity {
  critical
  high
  medium
  low

  @@map("issue_severity")
  @@schema("issue")
}

/// Nine states, no more: `detected → investigating → diagnosed → acting → resolved`, with
/// `needs_human` off diagnosed/acting, `stale` off any non-terminal, `merged` off any state, and
/// `resolved → investigating` on a reopen inside the window (data-model.md "State transitions").
/// `knowledge_drift` issues terminate at `needs_human` and never reach `acting` (FR-001a).
enum IssueState {
  detected
  investigating
  diagnosed
  acting
  resolved
  needs_human
  stale
  merged
  removed

  @@map("issue_state")
  @@schema("issue")
}

/// The single store for every issue-to-issue link (FR-020).
model IssueRelationship {
  id           String                @id @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  issueId      String                @map("issue_id") @db.Uuid
  otherIssueId String                @map("other_issue_id") @db.Uuid
  kind         IssueRelationshipKind
  /// Which deterministic correlation rule produced it, or `human` — so a `related` link can be
  /// explained and recomputed, never a model's proposal (FR-020).
  rule         String
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when a merge is undone or a correlation is withdrawn (R-08) — never deleted, so the
  /// history of what was once related is never lost.
  removedAt    DateTime?             @map("removed_at") @db.Timestamptz(6)

  // Composite FKs against Issue's (id, tenantId): a relationship naming a subject or other issue
  // outside its own tenant is rejected by Postgres, not merely mis-indexed (FR-048).
  issue      Issue @relation("IssueRelationshipSubject", fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)
  otherIssue Issue @relation("IssueRelationshipOther", fields: [otherIssueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, otherIssueId, kind])
  @@map("issue_relationship")
  @@schema("issue")
}

enum IssueRelationshipKind {
  related
  recurrence_of
  merged_into

  @@map("issue_relationship_kind")
  @@schema("issue")
}

/// Append-only. Domain facts only — 012's `workflow_transition` holds machine steps (C-14); the
/// timeline is a union query over both, plus `evidence`, never a copy of either into the other.
model IssueEvent {
  id         String          @id @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  issueId    String          @map("issue_id") @db.Uuid
  type       IssueEventType
  fromState  IssueState?     @map("from_state")
  toState    IssueState?     @map("to_state")
  cause      IssueEventCause
  actorRef   String          @map("actor_ref")
  /// Bounded, no free-form customer text — a structured record, not a log line.
  payload    Json
  observedAt DateTime        @map("observed_at") @db.Timestamptz(6)
  receivedAt DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)

  // Composite FK against Issue's (id, tenantId) — see IssueRelationship's comment (FR-048).
  issue Issue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, issueId, observedAt])
  @@map("issue_event")
  @@schema("issue")
}

enum IssueEventType {
  signal_received
  state_changed
  merged
  unmerged
  related
  action_taken
  note

  @@map("issue_event_type")
  @@schema("issue")
}

enum IssueEventCause {
  ingestion
  agent
  human
  policy
  system

  @@map("issue_event_cause")
  @@schema("issue")
}

/// The idempotency key for signal ingestion (R-09): the same delivery posted twice is a no-op.
model IngestionDelivery {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  provider    String
  deliveryId  String           @map("delivery_id")
  receivedAt  DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)
  signalCount Int              @map("signal_count")
  outcome     IngestionOutcome

  // tenant_id leads the idempotency key, not just `(provider, delivery_id)` as data-model.md's
  // prose says: a provider's delivery id is not guaranteed globally unique across tenants (a
  // customer-facing webhook provider may hand out small, predictable ids), and without tenant_id
  // here, tenant B's delivery "1" would collide with tenant A's — either dropped as a false
  // duplicate or, worse, revealing that A already used that id. Isolation never rests on an
  // upstream id happening to be unique (QUESTIONS.md).
  @@unique([tenantId, provider, deliveryId])
  @@index([tenantId, receivedAt])
  @@map("ingestion_delivery")
  @@schema("issue")
}

enum IngestionOutcome {
  accepted
  duplicate
  partial
  failed

  @@map("ingestion_outcome")
  @@schema("issue")
}

/// Never edited; a rule change is a new version, so a historical fingerprint stays explicable
/// and recomputable a year later (R-01).
model NormalisationRuleset {
  version     Int      @id
  rules       Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  note        String?

  issues Issue[]

  @@map("normalisation_ruleset")
  @@schema("issue")
}

/// Append-only, except `refState` moving `linked → detached` (R-03) — enforced by database rule,
/// not application discipline (a repository that "does not expose update" is one careless method
/// away from being wrong).
model Evidence {
  id               String       @id @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  issueId          String       @map("issue_id") @db.Uuid
  type             EvidenceType
  sourceSystem     String       @map("source_system")
  sourceRef        String       @map("source_ref")
  /// Human-readable; survives detachment — "from logs, March" (R-04).
  sourceLabel      String       @map("source_label")
  /// Bounded at capture (R-05); null when the type carries no excerpt.
  excerpt          String?
  excerptTruncated Boolean      @default(false) @map("excerpt_truncated")
  /// Structured fields for the type, schema-validated against 012's boundary schemas — no
  /// free-form strings.
  payload          Json
  /// Which step observed this (R-06) — the producer, not the caller's say-so.
  producedByStep   String       @map("produced_by_step")
  refState         RefState     @default(linked) @map("ref_state")
  observedAt       DateTime     @map("observed_at") @db.Timestamptz(6)
  receivedAt       DateTime     @default(now()) @map("received_at") @db.Timestamptz(6)
  /// Retention — shorter than issue retention.
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(6)

  links EvidenceLink[]

  // Composite FK against Issue's (id, tenantId) (FR-048) — resolves the question logged in
  // QUESTIONS.md: `evidence` stays its own package (different lifetime, different mutability),
  // but that is a code-dependency-direction concern, not a reason to leave the DB able to store
  // evidence under one tenant pointing at another tenant's issue. `onDelete: Restrict` does not
  // block the retention/tenant-deletion paths (T052/T053): both go through the
  // `healer.privileged_write` bypass already, the same one the append-only triggers check.
  issue Issue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, issueId, observedAt])
  // 001 T052: what the retention sweep filters and orders on.
  @@index([tenantId, expiresAt])
  @@map("evidence")
  @@schema("evidence")
}

enum EvidenceType {
  error_signature
  trace_shape
  metric_delta
  deploy_ref
  commit_ref
  test_result
  file_path
  tool_output_summary
  document_excerpt
  collection_gap
  /// 002 FR-012.
  budget_degradation
  /// All four of 004's discovery shapes — component_candidate, deployment_unit_candidate,
  /// dependency_observation, repository_ref — persist as this one type, the shape name and its
  /// fields in `payload`: the transport contract is closed per fact family, but "what we
  /// observed about the architecture" is one kind of observation (001's call, FR-007a).
  graph_fact

  @@map("evidence_type")
  @@schema("evidence")
}

enum RefState {
  linked
  detached

  @@map("ref_state")
  @@schema("evidence")
}

/// Append-only, no exceptions. No API creates a link for a step other than the caller, and none
/// creates links retrospectively (R-06).
model EvidenceLink {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  evidenceId     String           @map("evidence_id") @db.Uuid
  conclusionType ConclusionType   @map("conclusion_type")
  conclusionId   String           @map("conclusion_id") @db.Uuid
  relation       EvidenceRelation
  /// Must equal the step that executed the write — a mismatch is rejected, never silently
  /// corrected (R-06).
  assertedByStep String           @map("asserted_by_step")
  assertedAt     DateTime         @default(now()) @map("asserted_at") @db.Timestamptz(6)

  // Composite FK against Evidence's (id, tenantId) (FR-048) — a link naming another tenant's
  // evidence is rejected by Postgres, not merely mis-indexed.
  evidence Evidence @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([evidenceId, conclusionId, relation])
  @@index([tenantId, conclusionType, conclusionId])
  @@map("evidence_link")
  @@schema("evidence")
}

enum ConclusionType {
  classification
  diagnosis
  hypothesis
  impact
  verification
  support_answer
  remediation

  @@map("conclusion_type")
  @@schema("evidence")
}

enum EvidenceRelation {
  supports
  contradicts
  contextualises

  @@map("evidence_relation")
  @@schema("evidence")
}

/// Append-only. Stands alongside 012's `agent_run`, never a second store of the same facts
/// (C-13) — this indexes every actor; `agent_run` is one agent invocation, resolved through
/// `agent_run_id`.
model AuditEntry {
  id               String         @id @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  actorType        AuditActorType @map("actor_type")
  actorRef         String         @map("actor_ref")
  /// A registered `policy_action.action_key` (002), never free text — the join key
  /// `check:policy-coverage` reconciles executed mutating actions against decisions on.
  action           String
  targetType       String         @map("target_type")
  targetId         String         @map("target_id") @db.Uuid
  reason           String
  evidenceIds      String[]       @map("evidence_ids") @db.Uuid
  agentRunId       String?        @map("agent_run_id") @db.Uuid
  policyDecisionId String?        @map("policy_decision_id") @db.Uuid
  outcome          String
  occurredAt       DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt])
  @@index([tenantId, targetType, targetId])
  @@map("audit_entry")
  @@schema("audit")
}

enum AuditActorType {
  agent
  human
  system
  runner

  @@map("audit_actor_type")
  @@schema("audit")
}

/// Content is not retained — only the fact that a deletion happened (R-12).
model DeletionTombstone {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  targetType  String   @map("target_type")
  targetId    String   @map("target_id") @db.Uuid
  requestedBy String   @map("requested_by")
  deletedAt   DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)
  reason      String

  // 001 T053: one tombstone per deleted target. Immutable and length-bounded by triggers/CHECKs
  // in migration 20260929000000, which Prisma cannot express.
  @@unique([tenantId, targetType, targetId])
  @@index([tenantId, deletedAt])
  @@map("deletion_tombstone")
  @@schema("audit")
}

// ────────────────────────── policy engine, autonomy and budgets (002) ──────────────────────────

/// Immutable (R-01): republishing identical content is a no-op, changed content is a new version.
/// No update or delete path — enforced by a `BEFORE UPDATE OR DELETE` trigger, not application
/// discipline (T003).
model PolicyRuleset {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  /// Monotone per tenant; a decision cites this.
  version           Int
  /// Content hash over the ordered rule bodies.
  digest            String
  publishedAt       DateTime @map("published_at") @db.Timestamptz(6)
  publishedBy       String   @map("published_by")
  /// The version this replaced.
  supersedesVersion Int?     @map("supersedes_version")
  /// Rule pairs that can both match with different outcomes (FR-006).
  conflictWarnings  Json     @map("conflict_warnings")

  rules PolicyRule[]

  // A decision's ruleset_version must resolve to exactly one ruleset per tenant, forever
  // (FR-004, SC-003) — the unique constraint the join relies on.
  @@unique([tenantId, version])
  @@unique([tenantId, digest])
  @@map("policy_ruleset")
  @@schema("policy")
}

/// Immutable, belongs to a rule set — it carries no tenant_id of its own; a rule is never read
/// except through its ruleset. No update or delete path (T003).
model PolicyRule {
  id         String           @id @db.Uuid
  rulesetId  String           @map("ruleset_id") @db.Uuid
  /// Stable across versions, so a rule can be followed through history.
  ruleKey    String           @map("rule_key")
  /// Conjunction of (field, operator, value) from the closed predicate vocabulary
  /// (contracts/evaluation.md) — schema-validated on publish, not here.
  predicates Json
  outcome    PolicyOutcome
  /// Carried into the decision; never free text.
  reasonCode PolicyReasonCode @map("reason_code")
  /// Tenant-facing explanation, shown in the approval summary.
  note       String

  ruleset PolicyRuleset @relation(fields: [rulesetId], references: [id], onDelete: Restrict)

  // There is no priority column — evaluation matches every rule and folds (R-04).
  @@unique([rulesetId, ruleKey])
  @@map("policy_rule")
  @@schema("policy")
}

/// Shared by policy_rule.outcome and policy_decision.outcome (contracts/evaluation.md).
enum PolicyOutcome {
  allow
  require_approval
  deny

  @@map("policy_outcome")
  @@schema("policy")
}

/// The closed reason-code vocabulary (data-model.md) — adding one is a spec change, so a decision
/// can never carry a reason nobody planned for. Spelled upper-snake exactly as data-model.md and
/// contracts/evaluation.md's error-code vocabulary give it, unlike this file's other enums.
enum PolicyReasonCode {
  NO_MATCHING_RULE
  CEILING_EXCEEDED
  NO_AUTONOMY_GRANT
  GRANT_REVOKED
  ENVIRONMENT_RESTRICTED
  COMPONENT_RESTRICTED
  ISSUE_KIND_RESTRICTED
  IMPACT_CLASS_RESTRICTED
  EVIDENCE_INCOMPLETE
  NO_ADOPTED_EXPECTATION
  UNDO_NOT_ATTESTED
  BUDGET_EXHAUSTED
  RATE_LIMITED
  COOLDOWN
  ATTEMPT_CAP_REACHED
  APPROVAL_REQUIRED
  APPROVAL_EXPIRED
  TARGET_BLOCKED
  CATEGORY_NOT_ALLOWLISTED
  TOPIC_BLOCKED

  @@map("policy_reason_code")
  @@schema("policy")
}

/// The action registry — global, not tenant-scoped: the set of actions the product can perform is
/// a product fact. Reversibility is not here; it is derived from 010's catalogue (R-06).
model PolicyAction {
  actionKey    String            @id @map("action_key")
  actionClass  PolicyActionClass @map("action_class")
  mutating     Boolean
  owningSpec   String            @map("owning_spec")
  introducedAt DateTime          @map("introduced_at") @db.Timestamptz(6)

  autonomyGrants AutonomyGrant[]

  @@map("policy_action")
  @@schema("policy")
}

enum PolicyActionClass {
  read_only
  code_change
  repository_write
  reversible_remediation
  merge
  forward_deploy
  irreversible

  @@map("policy_action_class")
  @@schema("policy")
}

/// A narrower grant never widens a broader one — grants are additive and the ceiling clamps the
/// maximum (R-05). The `level <= ACTION_CEILING(action_class, has_tested_undo)` check (C-18) is
/// not a database constraint yet: `has_tested_undo` resolves through 010's remediation catalogue,
/// which does not exist in this repository yet — deferred to the batch that adds ceiling.ts.
model AutonomyGrant {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// Null = all components (004).
  componentId String?   @map("component_id") @db.Uuid
  /// Null = all environments.
  environment String?
  /// Null = all kinds (001 FR-001).
  issueKind   String?   @map("issue_kind")
  actionKey   String    @map("action_key")
  level       Int
  grantedBy   String    @map("granted_by")
  grantedAt   DateTime  @map("granted_at") @db.Timestamptz(6)
  revokedBy   String?   @map("revoked_by")
  /// Set once; a revoked grant is never reactivated.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  action PolicyAction @relation(fields: [actionKey], references: [actionKey], onDelete: Restrict)

  // Partial index `(tenant_id, action_key, environment) WHERE revoked_at IS NULL` — Prisma cannot
  // express a partial index (same limitation as WorkflowRun's deadline index above); created
  // directly in the migration and deliberately not declared here.
  @@map("autonomy_grant")
  @@schema("policy")
}

/// One row per tenant; incremented by every grant revocation — the single write that makes
/// revocation immediate (R-07).
model AutonomyEpoch {
  tenantId   String   @id @map("tenant_id") @db.Uuid
  epoch      BigInt
  bumpedAt   DateTime @map("bumped_at") @db.Timestamptz(6)
  bumpedBy   String   @map("bumped_by")
  bumpReason String   @map("bump_reason")

  @@map("autonomy_epoch")
  @@schema("policy")
}

/// Append-only except `consumed_at` and `invalidated_reason` transitioning from null — enforced
/// by database trigger (T003), not application discipline.
model PolicyDecision {
  id                String        @id @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  issueId           String?       @map("issue_id") @db.Uuid
  /// 012 — the run this decision is bound to.
  workflowRunId     String?       @map("workflow_run_id") @db.Uuid
  /// The guarded step.
  workflowState     String?       @map("workflow_state")
  actionKey         String        @map("action_key")
  /// The target the action was proposed against — the limit scope (C-11).
  targetRef         String?       @map("target_ref")
  /// The issue fingerprint (001 FR-002) — the other half of the limit scope.
  fingerprint       String?
  /// Canonical hash of the DecisionInput; a decision is valid for this digest only.
  proposalDigest    String        @map("proposal_digest")
  /// The full closed record, stored for replay (R-03).
  decisionInput     Json          @map("decision_input")
  /// Resolves forever (FR-004, SC-003).
  rulesetVersion    Int           @map("ruleset_version")
  matchedRuleKeys   String[]      @map("matched_rule_keys")
  outcome           PolicyOutcome
  reasonCodes       String[]      @map("reason_codes")
  /// True when the clamp changed the outcome (R-05).
  ceilingApplied    Boolean       @map("ceiling_applied")
  /// Consumed, limit, declared max of the next step, degradation step.
  budgetState       Json          @map("budget_state")
  /// Passed in, not read from a clock inside the evaluator — a decision replays identically.
  evaluatedAt       DateTime      @map("evaluated_at") @db.Timestamptz(6)
  /// Set when the guarded step executes against it.
  consumedAt        DateTime?     @map("consumed_at") @db.Timestamptz(6)
  /// epoch_bump · approval_expired · digest_mismatch.
  invalidatedReason String?       @map("invalidated_reason")

  approvalRequests ApprovalRequest[]

  // Backs ApprovalRequest's composite FK (decisionId, tenantId) — same pattern as WorkflowRun /
  // Issue / Evidence (FR-048): an approval naming a wrong tenant's decision is unrepresentable,
  // not merely unindexed.
  @@unique([id, tenantId])
  // Also the index the rate, cooldown and attempt-cap predicates read (R-13, C-11).
  @@index([tenantId, actionKey, targetRef, fingerprint, evaluatedAt])
  @@index([workflowRunId])
  @@map("policy_decision")
  @@schema("policy")
}

/// `summary` holds identifiers and structured fields only — collected customer text never enters
/// it: an approval screen rendering attacker-influenced prose is a phishing surface aimed at the
/// one human whose click authorises a mutation (data-model.md).
model ApprovalRequest {
  id            String        @id @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  decisionId    String        @map("decision_id") @db.Uuid
  /// 012.
  workflowRunId String        @map("workflow_run_id") @db.Uuid
  /// Proposed action, reason, evidence ids, impact summary, rollback plan (FR-015).
  summary       Json
  /// 001 — the approver sees the evidence, not a narrative.
  evidenceIds   String[]      @map("evidence_ids") @db.Uuid
  /// Recorded at issue; re-checked at redemption (R-07).
  autonomyEpoch BigInt        @map("autonomy_epoch")
  /// Projected onto workflow_run.deadline_at.
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(6)
  state         ApprovalState
  /// The human, for approved and rejected (FR-017).
  resolvedBy    String?       @map("resolved_by")
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz(6)

  decision PolicyDecision @relation(fields: [decisionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([decisionId])
  @@index([tenantId, state, expiresAt])
  @@map("approval_request")
  @@schema("policy")
}

enum ApprovalState {
  pending
  approved
  rejected
  expired
  revoked

  @@map("approval_state")
  @@schema("policy")
}

/// Per-issue limits, and the per-tenant-period limits inherited from 012's tenant_budget.
model BudgetLimit {
  id                   String            @id @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  scopeType            BudgetScopeType   @map("scope_type")
  scopeId              String?           @map("scope_id") @db.Uuid
  period               BudgetLimitPeriod
  spendLimit           Decimal           @map("spend_limit") @db.Decimal(12, 4)
  timeLimitMs          Int               @map("time_limit_ms")
  /// Ordered degradation steps (R-12) — same shape as 012's tenant_budget.soft_threshold_pcts,
  /// which is what makes the per-tenant-period limits inheritable rather than convertible.
  softThresholdPcts    Int[]             @map("soft_threshold_pcts")
  escalationAttemptCap Int               @map("escalation_attempt_cap")
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy            String            @map("updated_by")

  @@index([tenantId, scopeType, scopeId])
  @@map("budget_limit")
  @@schema("policy")
}

enum BudgetScopeType {
  issue
  tenant

  @@map("budget_scope_type")
  @@schema("policy")
}

/// Distinct from tenant.budget_period (012): this one also has `issue` as a period.
enum BudgetLimitPeriod {
  issue
  day
  month

  @@map("budget_limit_period")
  @@schema("policy")
}

/// Rate limits, cooldowns and attempt caps (FR-014) — owned here and nowhere else (C-11). Counts
/// are not stored: aggregated from policy_decision history for (action_key, target_ref,
/// fingerprint) in the same query that loads the rule set (R-13). 010 keeps no limit store of its
/// own and projects only the refusal reason codes.
model ActionLimit {
  tenantId        String   @map("tenant_id") @db.Uuid
  actionKey       String   @map("action_key")
  ratePerWindow   Int      @map("rate_per_window")
  windowSeconds   Int      @map("window_seconds")
  cooldownSeconds Int      @map("cooldown_seconds")
  attemptCap      Int      @map("attempt_cap")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String   @map("updated_by")

  @@id([tenantId, actionKey])
  @@map("action_limit")
  @@schema("policy")
}

/// The idempotency key for "this degradation step has already been recorded as evidence" (R-12).
/// Carries no state of its own — the state is the evidence record.
model BudgetDegradationMark {
  tenantId   String          @map("tenant_id") @db.Uuid
  scopeType  BudgetScopeType @map("scope_type")
  scopeId    String          @map("scope_id") @db.Uuid
  periodKey  String          @map("period_key")
  step       Int
  evidenceId String          @map("evidence_id") @db.Uuid
  markedAt   DateTime        @map("marked_at") @db.Timestamptz(6)

  @@id([tenantId, scopeType, scopeId, periodKey, step])
  @@map("budget_degradation_mark")
  @@schema("policy")
}
