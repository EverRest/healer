{
  "name": "healer",
  "version": "0.35.0",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build tsconfig.json",
    "build": "tsc --build tsconfig.json",
    "lint": "eslint .",
    "format-check": "prettier --check .",
    "test-unit": "vitest run --project unit --coverage",
    "test-e2e": "vitest run --project e2e",
    "db-generate": "prisma generate",
    "db-check": "node scripts/db-check.mjs",
    "db-seed": "node --env-file=.env scripts/db-seed.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "contracts-check": "node scripts/gates/contracts-check.mjs",
    "gate-isolation": "node scripts/gates/isolation.mjs",
    "gate-undo": "node scripts/gates/undo.mjs",
    "gate-evidence": "node scripts/gates/evidence.mjs",
    "gate-architecture-agnostic": "node scripts/gates/architecture-agnostic.mjs",
    "gate-data-model": "node scripts/gates/data-model.mjs",
    "gate-no-send": "node scripts/gates/no-send.mjs",
    "gate-coverage-completeness": "node scripts/gates/coverage-completeness.mjs",
    "deps-check": "node scripts/gates/deps-check.mjs"
  },
  "devDependencies": {
    "@healer/domain-evidence": "workspace:*",
    "@healer/domain-issues": "workspace:*",
    "@healer/events": "workspace:*",
    "@healer/prisma-client": "workspace:*",
    "@healer/shared": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "testcontainers": "^10.16.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0"
  }
}
