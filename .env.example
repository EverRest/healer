# Local development. `make bootstrap` starts the services these point at
# (docker/docker-compose.yml). No production value belongs in this file or in .env.
DATABASE_URL="postgresql://healer:healer@localhost:5432/healer?schema=public"
REDIS_URL="redis://localhost:6379"
HTTP_PORT=3000
LOG_LEVEL=debug
SERVICE_NAME=healer-api
